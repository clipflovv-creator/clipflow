# Backend Configuration Reference
PORT=3001
NODE_ENV=development
FRONTEND_URL=http://localhost:5173
BACKEND_URL=http://localhost:3001

# MongoDB Connection
MONGODB_URI=mongodb+srv://username:password@cluster.mongodb.net/clipflow?retryWrites=true&w=majority

# Security Secrets (32+ characters)
SESSION_SECRET=your_super_secret_session_key_at_least_32_bytes_long
ENCRYPTION_KEY=your_application_level_32_byte_secret_key_here!

# Google Master Drive Storage
GOOGLE_MASTER_CLIENT_ID=
GOOGLE_MASTER_CLIENT_SECRET=
GOOGLE_MASTER_REFRESH_TOKEN=
GOOGLE_MASTER_ROOT_FOLDER_NAME=ClipFlow

# Google OAuth 2.0
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3001/api/auth/google/callback

# YouTube Download Bypass (required on cloud hosting - Render/Railway/Fly etc)
# Render's datacenter IPs are hard-blocked by YouTube. Use a residential proxy to bypass.
# Free tier: https://webshare.io (10 free residential proxies)
# Format: http://user:pass@host:port  OR  socks5://user:pass@host:port
YTDLP_PROXY=

# YouTube PO Token (optional, improves bypass reliability when combined with cookies)
# Get from browser DevTools > Network > filter 'player' > find po_token in request body
YTDLP_PO_TOKEN=

# YouTube Cookies (optional but highly recommended for age-gated / restricted videos)
# Export from browser using 'cookies.txt' extension (Netscape format), then base64-encode:
# base64 -w 0 cookies.txt
YOUTUBE_COOKIES_BASE64=
